# Copiar como wrangler.toml. Los secretos NUNCA van acá: usar `wrangler secret put NOMBRE`.
name = "cad2d-billing"
main = "worker.js"
compatibility_date = "2026-11-01"

[vars]
APP_ORIGIN = "https://tu-dominio.org"               # origen exacto de la app (sin barra final)
APP_PATH = "/"                                       # "/blackline-cad/" si se sigue usando GitHub Pages
API_ORIGIN = "https://api.tu-dominio.com"           # dominio del Worker
COOKIE_DOMAIN = "tu-dominio.org"                     # app en tu-dominio.org y API en api.tu-dominio.org
TRIAL_DAYS = "120"
STRIPE_TAX = "1"                                     # IVA automático con Stripe Tax (requiere configurarlo en el Dashboard)
MAIL_FROM = "CAD2D <acceso@tu-dominio.com>"
PRICE_PRO_MONTHLY = "price_xxx"
PRICE_PRO_YEARLY = "price_xxx"
PRICE_STUDIO_MONTHLY = "price_xxx"

[[d1_databases]]
binding = "DB"
database_name = "cad2d"
database_id = "reemplazar-con-el-id-de-d1"
